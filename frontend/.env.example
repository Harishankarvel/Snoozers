# AURA-AV Autonomous Vehicle Decision Support Dashboard
# Backend WebSocket URL Configuration

# For local development (default fallback if omitted):
# VITE_WS_URL=ws://localhost:8000

# For production deployment on Vercel connecting to Render backend:
# (Replace with your actual Render web service URL, both wss:// and https:// work automatically)
VITE_WS_URL=wss://your-render-backend.onrender.com
